# The load balancer itself
resource "aws_lb" "web" {
  name               = "pelumi-practice-lb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.web.id]
  subnets            = [aws_subnet.public.id]

  tags = {
    Name = "pelumi-practice-lb"
  }
}

# The target group: the set of servers the load balancer sends traffic to
resource "aws_lb_target_group" "web" {
  name     = "pelumi-practice-tg"
  port     = 80
  protocol = "HTTP"
  vpc_id   = aws_vpc.main.id
}

# Attach each EC2 instance to that target group
resource "aws_lb_target_group_attachment" "web" {
  count            = 2
  target_group_arn = aws_lb_target_group.web.arn
  target_id        = aws_instance.web[count.index].id
  port             = 80
}

# The listener: tells the load balancer what to do with incoming traffic
resource "aws_lb_listener" "web" {
  load_balancer_arn = aws_lb.web.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.web.arn
  }
}

